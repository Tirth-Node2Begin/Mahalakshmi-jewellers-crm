# ============================================================
# Jewellers CRM / ERP — environment config (development template)
# Copy to .env and fill in. NEVER commit .env.
# Production template: .env.production.example (+ DEPLOY.md)
# ============================================================

# --- App ---
APP_ENV=development                      # development | production
APP_URL=http://localhost:8000            # PHP API base (informational)
FRONTEND_URL=http://localhost:3000       # Next.js dev server (informational)
APP_FORCE_HTTPS=0                        # 1 in production — adds HSTS header
TIMEZONE=Asia/Kolkata

# --- Database (MySQL/MariaDB, utf8mb4) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jewellers_crm
DB_USER=root
DB_PASS=

# --- Auth / security ---
# generate secrets: php -r "echo bin2hex(random_bytes(32));"
JWT_ISSUER=jewellers-crm
JWT_AUDIENCE=jewellers-crm-web
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX
JWT_ACCESS_TTL=900                       # access cookie lifetime, seconds (15 min)
REFRESH_TTL=2592000                      # refresh token, 30 days
REFRESH_TTL_REMEMBER=7776000             # refresh with "remember me", 90 days
CSRF_SECRET=CHANGE_ME_64_HEX
COOKIE_SECURE=0                          # 1 in production (HTTPS only)
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=                           # leave empty — host-only cookies
LOGIN_RATE_LIMIT=15                      # attempts per window per user+IP
LOGIN_RATE_WINDOW=300                    # seconds

# --- CORS ---
# Comma-separated browser origins allowed to call the API with credentials.
# Add your LAN IP for multi-counter testing, e.g. http://192.168.1.5:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Encryption at rest (32-byte base64) ---
# generate: php -r "echo base64_encode(random_bytes(32));"
APP_ENC_KEY=CHANGE_ME_BASE64_32_BYTES

# --- Cron guard (api/cron/* endpoints check this key) ---
CRON_KEY=CHANGE_ME_64_HEX

# --- Daily rate feed (api/cron/fetch_rates.php) ---
# Outbound HTTPS to ibjarates.com. Certificate verification is always on and
# cannot be disabled; Windows PHP builds ship without a CA bundle, so point this
# at one during local development. Leave EMPTY on Linux/cPanel — the system
# store is found automatically.
#   e.g. CURL_CA_BUNDLE="C:\Program Files\Git\usr\ssl\certs\ca-bundle.crt"
CURL_CA_BUNDLE=

# --- Mail — password-reset OTP (api/v1/auth/forgot-password.php) ---
# Leave SMTP_HOST/SMTP_USER empty in development: the OTP is written to the
# PHP error log instead of being sent. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@node2begin.com
