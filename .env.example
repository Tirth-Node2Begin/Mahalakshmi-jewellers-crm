# ============================================================
# LeadSpark CRM — environment config
# Copy to .env and fill in. NEVER commit .env.
# How to obtain the Google/Facebook values: see API-SETUP-GUIDE.md
# ============================================================

# --- App ---
APP_ENV=development                      # development | production
APP_URL=http://localhost:8000            # PHP API base
FRONTEND_URL=http://localhost:3000
APP_FORCE_HTTPS=0                        # 1 in production
TIMEZONE=Asia/Kolkata

# --- Database (MySQL/MariaDB, utf8mb4) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leadspark_crm
DB_USER=root
DB_PASS=

# --- Auth / security (generate: php -r "echo bin2hex(random_bytes(32));") ---
JWT_ISSUER=leadspark-crm
JWT_AUDIENCE=leadspark-crm-web
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX
JWT_ACCESS_TTL=900
REFRESH_TTL=2592000                      # 30 days
REFRESH_TTL_REMEMBER=7776000             # 90 days (remember me)
CSRF_SECRET=CHANGE_ME_64_HEX
COOKIE_SECURE=0                          # 1 in production (HTTPS)
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT=15
LOGIN_RATE_WINDOW=300

# --- Encryption at rest for integration tokens (32-byte base64) ---
# generate: php -r "echo base64_encode(random_bytes(32));"
APP_ENC_KEY=CHANGE_ME_BASE64_32_BYTES

# --- Webhook + cron guards (generate like the secrets above) ---
LEAD_WEBHOOK_SECRET=CHANGE_ME
CRON_KEY=CHANGE_ME

# --- Google Business Profile dashboard (API-SETUP-GUIDE.md §1) ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback.php

# --- Facebook / Meta insights dashboard (API-SETUP-GUIDE.md §2) ---
FB_APP_ID=000000000000000
FB_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FB_REDIRECT_URI=http://localhost:8000/api/integrations/facebook/callback.php
FB_GRAPH_VERSION=v25.0
FB_LOGIN_CONFIG_ID=000000000000000       # Facebook Login for Business configuration ID

# --- Mail (password-reset OTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@yourdomain.com
