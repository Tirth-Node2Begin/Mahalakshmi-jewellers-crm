Options -Indexes

# ── Force HTTPS ───────────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Block everything that is not the app or the API ───────────
# PHP source, schema, CLI tools, docs must never be web-readable.
RewriteRule ^(src|database|cli|plan|planning|deploy)(/|$) - [F,L]

# .env and any dotfile
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Markdown docs if they were uploaded by mistake
<FilesMatch "\.(md|sql|sh|bat|lock)$">
    Require all denied
</FilesMatch>

# ── Static-export routing ─────────────────────────────────────
# The Next.js export uses folder-style URLs (/billing/ -> billing/index.html),
# so Apache serves each route natively. Unknown paths fall to the 404 page.
ErrorDocument 404 /404.html

# ── Caching ───────────────────────────────────────────────────
# Measured 2026-08-04: the host sent NO Cache-Control on any asset, only
# Last-Modified. The browser then re-validates every file on every visit —
# ~20 conditional requests, each a full round trip. On this connection that is
# ~366 ms of latency per file and nothing is even downloaded: the answer is
# always 304. That revalidation storm, not PHP, is what makes the app feel slow.
#
# Everything under /_next/static/ is content-hashed by the build (the filename
# changes whenever the contents change), so it can be cached permanently and
# never re-checked. `immutable` is what stops the conditional request.
#
# Matched BY PATH, not by extension: favicon.ico and icon.svg sit at the root
# with fixed names, and freezing those for a year would make a future logo
# change unshippable.
SetEnvIf Request_URI "_next/static/" CRM_IMMUTABLE=1

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=CRM_IMMUTABLE

    # HTML must NOT be cached that way or a deploy would never reach anyone —
    # the hashed asset names inside it are how a new build gets picked up.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Next.js route-payload files (index.txt, __next.*.txt) are regenerated by
    # every build. A stale one breaks client-side navigation after a deploy.
    <FilesMatch "\.txt$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Un-hashed root assets: cached, but only for a week, so replacing the logo
    # actually reaches people.
    <FilesMatch "^(favicon\.ico|icon\.svg|apple-icon\.png|manifest\.webmanifest)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # API responses carry live money and stock figures and are per-user. Never
    # let a browser or an intermediate proxy hold on to one.
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, private"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ETag adds a second validator that says nothing Last-Modified does not, and on
# shared hosting it can differ between front-end nodes and defeat caching.
FileETag None
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>

# ── Compression ───────────────────────────────────────────────
# The host already gzips HTML and JS. These lines make sure JSON API responses,
# SVG and fonts are covered too, and are harmless where it is already on.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# Brotli where the host has it — roughly 15-20% smaller than gzip on JS.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# Fonts are already compressed; re-compressing wastes CPU on every request.
<IfModule mod_deflate.c>
    SetEnvIfNoCase Request_URI \.(?:woff2?|ttf|otf|eot)$ no-gzip dont-vary
</IfModule>
