# ============================================================
# Jewellers CRM / ERP — PRODUCTION environment config
# For https://jeweller-crm.node2begin.com
# Copy to .env ON THE SERVER and fill in. NEVER commit .env.
# Generate every secret fresh — do not reuse the dev values:
#   php -r "echo bin2hex(random_bytes(32));"        (JWT/CSRF/CRON)
#   php -r "echo base64_encode(random_bytes(32));"  (APP_ENC_KEY)
# ============================================================

# --- App ---
APP_ENV=production
APP_URL=https://jeweller-crm.node2begin.com
FRONTEND_URL=https://jeweller-crm.node2begin.com
APP_FORCE_HTTPS=1
TIMEZONE=Asia/Kolkata

# --- Database (from the hosting panel: MySQL Databases) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME

# --- Auth / security ---
JWT_ISSUER=jewellers-crm
JWT_AUDIENCE=jewellers-crm-web
JWT_ACCESS_SECRET=CHANGE_ME_64_HEX
JWT_ACCESS_TTL=900
REFRESH_TTL=2592000
REFRESH_TTL_REMEMBER=7776000
CSRF_SECRET=CHANGE_ME_64_HEX
COOKIE_SECURE=1
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
LOGIN_RATE_LIMIT=15
LOGIN_RATE_WINDOW=300

# --- CORS ---
# Frontend and API share the origin in production, so this is only a
# safety net — keep it to the real domain, never "*".
CORS_ALLOWED_ORIGINS=https://jeweller-crm.node2begin.com

# --- Encryption at rest ---
APP_ENC_KEY=CHANGE_ME_BASE64_32_BYTES

# --- Cron guard ---
# Hosting-panel cron jobs call api/cron/* with this key, e.g.:
#   curl -s "https://jeweller-crm.node2begin.com/api/cron/daily_digest.php?key=<CRON_KEY>"
#   curl -s "https://jeweller-crm.node2begin.com/api/cron/fetch_rates.php?key=<CRON_KEY>"
CRON_KEY=CHANGE_ME_64_HEX

# --- Daily rate feed ---
# fetch_rates.php makes an outbound HTTPS call to ibjarates.com. Leave this
# empty unless the host's PHP has no CA bundle and the feed reports an SSL
# error — then set it to the bundle's absolute path.
CURL_CA_BUNDLE=

# --- Mail — password-reset OTP (REQUIRED in production) ---
# Without SMTP, "Forgot password" cannot email the OTP. Use the hosting
# provider's SMTP or a Gmail app password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@node2begin.com
SMTP_PASS=CHANGE_ME
MAIL_FROM=no-reply@node2begin.com
